# The frontend talks to Django on the same origin by default.
# For a split deployment (e.g. Netlify + Render), set the full API URL:
# REACT_APP_API_URL=https://your-api.onrender.com/api
REACT_APP_API_URL=

# Server-side secrets (Amadeus, OpenAI, Gemini, database) belong in
# backend/.env - never in this file. Anything prefixed with REACT_APP_ is
# shipped to the browser.
