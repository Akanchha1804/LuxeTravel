# ---------------------------------------------------------------------------
# Django core
# ---------------------------------------------------------------------------
# Set DEBUG=False in production.
DEBUG=True

# Required when DEBUG=False. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string

# Comma-separated hosts. Example: luxetravel.example.com,www.luxetravel.example.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated trusted HTTPS origins (needed for Django admin over HTTPS).
# Example: https://luxetravel.example.com
CSRF_TRUSTED_ORIGINS=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Production (recommended): a single connection URL. Overrides DB_* below.
# DATABASE_URL=postgresql://user:password@host:5432/trip_planner
#
# Local development defaults to SQLite. To use a local Postgres instead:
# DB_ENGINE=postgres
# DB_NAME=trip_planner
# DB_USER=postgres
# DB_PASSWORD=password
# DB_HOST=localhost
# DB_PORT=5432

# ---------------------------------------------------------------------------
# CORS (only needed when the frontend is hosted on a different domain)
# ---------------------------------------------------------------------------
# CORS_ALLOWED_ORIGINS=https://luxetravel.example.com
# CORS_ALLOW_ALL_ORIGINS=False

# ---------------------------------------------------------------------------
# AI itinerary generation (optional - the app has a curated fallback)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Travel search (optional - booking page falls back to sample results)
# Sign up at https://developers.amadeus.com
# ---------------------------------------------------------------------------
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test

# ---------------------------------------------------------------------------
# Rate limits
# ---------------------------------------------------------------------------
THROTTLE_ANON=120/min
THROTTLE_USER=600/min
THROTTLE_AI=10/min

# ---------------------------------------------------------------------------
# Security (set these when serving over HTTPS)
# ---------------------------------------------------------------------------
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
